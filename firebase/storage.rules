rules_version = '2';

// FTMP Storage rules
//
// Two zones:
//   data/**   — public OTA roster (manifest + ClubDatabase). Read-only for clients.
//   teams/**  — shared My Team folders. Auth required; owner-write for edits.
//
service firebase.storage {
  match /b/{bucket}/o {

    // ── OTA club/player database (no App Store release to update) ──────────
    // Clients fetch these with plain HTTPS (?alt=media). Writes only via
    // Firebase Console / Admin / CLI — never from the app.
    match /data/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /data/portraits/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /data/logos/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // ── My Team sharing ("capability code") ────────────────────────────────
    // A team lives under an unguessable code:
    //   teams/{code}/team.json
    //   teams/{code}/players/{file}
    match /teams/{teamId}/team.json {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.metadata.ownerUid == request.auth.uid;

      allow update, delete: if request.auth != null
        && resource.metadata.ownerUid == request.auth.uid
        && request.resource.size < 5 * 1024 * 1024;
    }

    match /teams/{teamId}/players/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
